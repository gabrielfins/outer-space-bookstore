unit CadastroFuncionarios;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Data.DB, Vcl.StdCtrls, Vcl.DBCtrls,
  Vcl.Mask, Vcl.Imaging.pngimage, Vcl.Imaging.jpeg, Vcl.ExtCtrls;

type
  Tfrm_CadastroFuncionarios = class(TForm)
    Image1: TImage;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    Label7: TLabel;
    Label8: TLabel;
    Label9: TLabel;
    Label10: TLabel;
    Label11: TLabel;
    Label12: TLabel;
    Label13: TLabel;
    Label14: TLabel;
    btn_Confirmar: TImage;
    btn_Adicionar: TImage;
    btn_Editar: TImage;
    btn_Excluir: TImage;
    DBEdit2: TDBEdit;
    DBEdit3: TDBEdit;
    edt_CPF: TDBEdit;
    edt_Nascimento: TDBEdit;
    edt_Telefone: TDBEdit;
    DBComboBox1: TDBComboBox;
    edt_CEP: TDBEdit;
    DBEdit8: TDBEdit;
    DBEdit9: TDBEdit;
    DBEdit10: TDBEdit;
    DBEdit11: TDBEdit;
    edt_Salario: TDBEdit;
    DBEdit13: TDBEdit;
