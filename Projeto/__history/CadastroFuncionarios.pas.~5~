var
  frm_CadastroFuncionarios: Tfrm_CadastroFuncionarios;

implementation
uses Conetion ;
{$R *.dfm}

procedure Tfrm_CadastroFuncionarios.btn_AdicionarClick(Sender: TObject);
begin
dm.Funcionarios2.Insert;
end;

procedure Tfrm_CadastroFuncionarios.btn_ConfirmarClick(Sender: TObject);
begin
dm.Funcionarios2.Post;
end;

procedure Tfrm_CadastroFuncionarios.btn_EditarClick(Sender: TObject);
begin
dm.Funcionarios2.Edit;
end;

procedure Tfrm_CadastroFuncionarios.btn_ExcluirClick(Sender: TObject);
begin
if (application.MessageBox('Deseja realmente excluir o registro?','Excluindo o registro',32+4)=mryes) then
dm.Funcionarios2.Delete;
end;

end.
