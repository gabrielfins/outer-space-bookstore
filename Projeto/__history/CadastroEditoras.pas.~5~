unit CadastroEditoras;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Imaging.pngimage, Vcl.StdCtrls,
  Vcl.Mask, Vcl.DBCtrls, Vcl.Imaging.jpeg, Vcl.ExtCtrls;

type
  Tfrm_CadastroEditoras = class(TForm)
    Label1: TLabel;
    DBEdit1: TDBEdit;
    Label2: TLabel;
    DBEdit2: TDBEdit;
    Label3: TLabel;
    DBEdit3: TDBEdit;
    Label4: TLabel;
    DBEdit4: TDBEdit;
    Label5: TLabel;
    DBEdit5: TDBEdit;
    Label6: TLabel;
    DBEdit6: TDBEdit;
    btn_Adicionar: TImage;
    btn_Editar: TImage;
    btn_Excluir: TImage;
    btn_Confirmar: TImage;
    Label7: TLabel;
    DBEdit7: TDBEdit;
    Image1: TImage;
    procedure btn_ConfirmarClick(Sender: TObject);
    procedure btn_AdicionarClick(Sender: TObject);
    procedure btn_EditarClick(Sender: TObject);
    procedure btn_ExcluirClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frm_CadastroEditoras: Tfrm_CadastroEditoras;

implementation
uses Conetion;
{$R *.dfm}

procedure Tfrm_CadastroEditoras.btn_AdicionarClick(Sender: TObject);
begin
dm.Editora.Insert;
end;

procedure Tfrm_CadastroEditoras.btn_ConfirmarClick(Sender: TObject);
begin
dm.Editora.Post;
end;

procedure Tfrm_CadastroEditoras.btn_EditarClick(Sender: TObject);
begin
dm.Editora.Edit;
end;

procedure Tfrm_CadastroEditoras.btn_ExcluirClick(Sender: TObject);
begin
if (application.MessageBox('Deseja realmente excluir o registro?','Excluindo o registro',32+4)=mryes) then
dm.Funcionarios2.Delete;
end;

end.
