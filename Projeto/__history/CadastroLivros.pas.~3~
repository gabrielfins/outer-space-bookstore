unit CadastroLivros;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Imaging.pngimage, Vcl.StdCtrls,
  Vcl.Mask, Vcl.DBCtrls, Vcl.Imaging.jpeg, Vcl.ExtCtrls;

type
  Tfrm_CadastroLivros = class(TForm)
    Image1: TImage;
    Label1: TLabel;
    DBEdit1: TDBEdit;
    Label2: TLabel;
    DBEdit2: TDBEdit;
    Label3: TLabel;
    DBEdit3: TDBEdit;
    Label4: TLabel;
    DBEdit4: TDBEdit;
    Label5: TLabel;
    DBEdit5: TDBEdit;
    Label6: TLabel;
    Image2: TImage;
    Label7: TLabel;
    btn_Confirmar: TImage;
    btn_Adicionar: TImage;
    btn_Editar: TImage;
    btn_Excluir: TImage;
    Label8: TLabel;
    DBEdit6: TDBEdit;
    lkp_Editora: TDBLookupComboBox;
    procedure btn_ConfirmarClick(Sender: TObject);
    procedure btn_AdicionarClick(Sender: TObject);
    procedure btn_EditarClick(Sender: TObject);
    procedure btn_ExcluirClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frm_CadastroLivros: Tfrm_CadastroLivros;

implementation
uses Conetion, CadastroEditoras;
{$R *.dfm}

procedure Tfrm_CadastroLivros.btn_AdicionarClick(Sender: TObject);
begin
dm.Livros.Insert;
end;

procedure Tfrm_CadastroLivros.btn_ConfirmarClick(Sender: TObject);
begin
dm.Livros.Post;
end;

procedure Tfrm_CadastroLivros.btn_EditarClick(Sender: TObject);
begin
dm.Livros.Edit;
end;

procedure Tfrm_CadastroLivros.btn_ExcluirClick(Sender: TObject);
begin
if (application.MessageBox('Deseja realmente excluir o registro?','Excluindo o registro',32+4)=mryes) then
dm.Funcionarios2.Delete;
end;

end.
